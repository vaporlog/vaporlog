# Contraseña de la base de datos PostgreSQL. OBLIGATORIA: cámbiala antes
# de desplegar. Puedes generar una segura con: openssl rand -hex 32
POSTGRES_PASSWORD=change-me-to-something-long-and-random

# VITE_API_URL solo hace falta si la API vive en OTRO origen (otro dominio
# o servidor). Con el despliegue Docker por defecto, el frontend y la API
# comparten origen (nginx redirige /api al contenedor de la API), así que
# déjala comentada.
# VITE_API_URL=https://api.tu-dominio.com

# Inicio de sesión con Google (opcional). OAuth Client ID de tipo "Web
# application" — NO es un secreto: viaja al navegador. Sin este valor el
# botón de Google simplemente no aparece. Ver DEPLOY.md, sección 13.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
