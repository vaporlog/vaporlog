# vaporlog — Caddy serves the SPA and proxies /api to the app container.
# Automatic HTTPS via Let's Encrypt: the certificate is obtained on first
# boot and renewed automatically. Requires the domain's DNS A record to
# point at this server BEFORE starting the container (HTTP-01 challenge
# over port 80).

vaporlog.online {
	encode gzip

	# Security headers for the SPA + API. CSP lives here (not in fastify's
	# helmet) so it also covers the static shell. script/frame/connect-src
	# allow accounts.google.com: the GIS button loads its client script and
	# renders its iframe from there (src/lib/google.ts).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; connect-src 'self' https://accounts.google.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
	}

	# API → fastify container (routes themselves live under /api)
	handle /api/* {
		reverse_proxy api:4000
	}

	# Shared session cards → server-rendered OG meta (WhatsApp/X previews).
	# The API answers with the SPA shell + per-session <meta> tags.
	handle /s/* {
		rewrite * /api/og{uri}
		reverse_proxy api:4000
	}

	# SPA: static files with history-API fallback
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}

	# Hashed build assets are immutable; the HTML shell is not.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path /index.html
	header @html Cache-Control "no-cache"
}

# Internal-only shell for the API's OG renderer: plain HTTP on 8080, any
# Host, never published to the host machine (container-to-container only).
# http://web/ would hit the HTTPS redirect above and undici refuses to
# follow it cross-scheme without extra machinery.
:8080 {
	root * /usr/share/caddy
	try_files {path} /index.html
	file_server
}
